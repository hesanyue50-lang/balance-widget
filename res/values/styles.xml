<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:fitsSystemWindows">false</item>
        <item name="android:textColorPrimary">@color/tx</item>
        <item name="android:textColorSecondary">@color/tx2</item>
        <!-- 全应用的 AlertDialog 都走这一套主题（含出现/消失动画）。
             挂在主题上比在每个 show() 后面手动设 windowAnimations 可靠 ——
             后者漏掉一处就少一个动画，而且新写的弹窗很容易忘。 -->
        <item name="android:alertDialogTheme">@style/AppDialogTheme</item>
    </style>

    <!-- 弹窗统一外观 + 动画 -->
    <style name="AppDialogTheme" parent="@android:style/Theme.DeviceDefault.Light.Dialog.Alert">
        <item name="android:windowAnimationStyle">@style/DialogAnim</item>
    </style>

    <style name="DialogAnim">
        <item name="android:windowEnterAnimation">@anim/dialog_in</item>
        <item name="android:windowExitAnimation">@anim/dialog_out</item>
    </style>

    <!-- 设置页分组样式 -->
    <!-- ⚠️ 标题色用 tx（主文字），不是 tx3 ——
         tx3 是"占位/辅助"档，做成标题会显得整页发灰、对比度不足
         （用户反馈过"设置页可读性差"）。分区标题是**导航锚点**，
         必须比正文更显眼，不是更弱。 -->
    <style name="SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginLeft">6dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textColor">@color/tx</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="SectionCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/card_aurora</item>
        <!-- 8pt 网格：27 → 24，对齐 skill 的固定间距集合 -->
        <item name="android:padding">24dp</item>
    </style>

    <style name="FieldRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="FieldLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/tx</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="FieldInput">
        <item name="android:layout_width">88dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/tx</item>
        <item name="android:textColorHint">@color/hint_c</item>
        <item name="android:singleLine">true</item>
        <item name="android:background">@drawable/input_aurora</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:paddingTop">19dp</item>
        <item name="android:paddingBottom">19dp</item>
    </style>

    <style name="FieldUnit">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginLeft">8dp</item>
        <item name="android:textColor">@color/tx2</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="FieldHint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">7dp</item>
        <item name="android:textColor">@color/tx3</item>
        <item name="android:textSize">11.5sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
</resources>
