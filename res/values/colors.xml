<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ===== Aurora Glass 亮色 token =====
         对齐 modern-ui-design skill 亮色基准：
         底 #F6F7F9（非纯白）、卡片纯白、描边 rgba(9,12,20,.075)、强调 #4166F5 -->

    <color name="bg">#F6F7F9</color>

    <color name="neu_surface">#FFFFFF</color>
    <color name="neu_light">#FFFFFF</color>
    <color name="neu_dark">#E5E9EF</color>
    <color name="neu_sunken">#EEF0F4</color>

    <color name="line">#14090C14</color>
    <color name="card_c">#FFFFFF</color>
    <color name="btn_c">#E3EAF9</color>
    <color name="input_c">#EEF0F4</color>
    <color name="total_start">#EDF1FB</color>
    <color name="total_end">#E4EAF8</color>

    <color name="tx">#0B0E14</color>
    <color name="tx2">#414A5C</color>
    <color name="tx3">#55606F</color>
    <color name="tx_conv">#687283</color>
    <color name="tx_detail">#39424F</color>
    <color name="hint_c">#7C8698</color>

    <!-- 按钮描边：比通用 line 稍重一点。按钮是"可点"的强信号，
         边框必须比卡片分隔线更明确，否则用户分不清"这是按钮还是标签"。 -->
    <color name="btn_border">#AEBEDF</color>

    <color name="accent">#4166F5</color>
    <color name="accent_tx">#FFFFFF</color>
    <color name="danger">#E5484D</color>
    <color name="warn">#B4690E</color>

    <color name="widget_bg_c">#FFFFFF</color>
    <color name="widget_line">#13000000</color>

    <!-- 玻璃风格专用：面板恒为深色半透明，故文字恒用浅色，
         不随系统深浅色切换（否则浅色模式下深字压深底，看不见） -->
    <color name="glass_tx">#1A1F28</color>
    <color name="glass_tx2">#3D4653</color>
    <color name="glass_tx3">#69738A</color>
    <color name="glass_tx_conv">#7C8698</color>
    <color name="glass_danger">#C0392B</color>
    <color name="glass_icon">#1A1F28</color>
    <color name="header_bg">#F0F4F7FB</color>
    <color name="header_line">#14000000</color>

    <!-- 制式分档之间的分隔线（浅色主题 / 玻璃主题） -->
    <color name="div_line">#26A8B4C6</color>
    <color name="glass_div_line">#3DFFFFFF</color>
</resources>
