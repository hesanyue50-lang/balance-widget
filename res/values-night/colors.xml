<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ===== Aurora Glass 暗色 token（基准主题） =====
         数值来源 modern-ui-design skill：
         · 底色近黑带蓝 #0A0B0F，不用纯黑
         · 卡片是「叠在底色上的半透明白」，不是实心灰块 —— 层级靠透明度叠加
         · 全站唯一强调色 #6C8CFF -->

    <color name="bg">#0A0B0F</color>

    <!-- neu_* 是旧新拟物体系的抬升面/按压面 —— 语义保留，值对齐新体系 -->
    <color name="neu_surface">#14161C</color>
    <color name="neu_light">#262B36</color>
    <color name="neu_dark">#06070A</color>
    <color name="neu_sunken">#07080B</color>

    <color name="line">#14FFFFFF</color>
    <!-- 卡片：半透明白叠加（≈ .035-.05 alpha），半透明描边由 card_bg drawable 负责 -->
    <color name="card_c">#0DFFFFFF</color>
    <color name="btn_c">#14FFFFFF</color>
    <color name="input_c">#08FFFFFF</color>
    <color name="total_start">#141A2E</color>
    <color name="total_end">#0E1220</color>

    <!-- 文字：主 #F5F7FA；次=62% 透明度；三级=38% -->
    <color name="tx">#F5F7FA</color>
    <color name="tx2">#9DA3B4</color>
    <color name="tx3">#8A93A6</color>
    <color name="tx_conv">#7C8698</color>
    <color name="tx_detail">#C4CAD6</color>
    <color name="hint_c">#6E7480</color>

    <!-- 唯一强调色 + 语义色 -->
    <color name="accent">#6C8CFF</color>
    <color name="accent_tx">#0A0B0F</color>
    <color name="danger">#FF5C5C</color>
    <color name="warn">#F5A524</color>

    <color name="widget_bg_c">#12141A</color>
    <color name="widget_line">#14FFFFFF</color>

    <!-- 玻璃风格专用：面板恒为深色半透明，故文字恒用浅色，
         不随系统深浅色切换（否则浅色模式下深字压深底，看不见） -->
    <color name="glass_tx">#F2F6FC</color>
    <color name="glass_tx2">#B6BFCC</color>
    <color name="glass_tx3">#8B95A5</color>
    <color name="glass_tx_conv">#7C8694</color>
    <color name="glass_danger">#FF8A8A</color>
    <color name="glass_icon">#F2F6FC</color>
    <color name="header_bg">#E60A0B0F</color>
    <color name="header_line">#14FFFFFF</color>

    <!-- 制式分档分隔线 -->
    <color name="div_line">#26A8B4C6</color>
    <color name="glass_div_line">#3DFFFFFF</color>

    <!-- ===== 小组件 v2 配色（暗色对齐） ===== -->
    <color name="w2_card">#12141A</color>
    <color name="w2_tx">#F5F7FA</color>
    <color name="w2_tx2">#9DA3B4</color>
    <color name="w2_tx3">#8A93A6</color>
    <color name="w2_div">#2E9AA6B2</color>
    <color name="w2_accent">#6C8CFF</color>
    <color name="w2_danger">#FF5C5C</color>
</resources>
