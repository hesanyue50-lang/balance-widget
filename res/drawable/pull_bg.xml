<?xml version="1.0" encoding="utf-8"?>
<!-- 下拉刷新指示器底色：
     用不透明的 neu_surface 而不是 card_bg.9.png —— 9-patch 有固定内边距，
     套在 20dp 高的小胶囊上会被撑变形；这里是纯 shape，随内容自适应。
     加一圈浅描边，浮在内容上也分得清。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="18dp" />
    <solid android:color="@color/neu_surface" />
    <stroke android:width="1dp" android:color="@color/neu_dark" />
</shape>
