<?xml version="1.0" encoding="utf-8"?>
<!-- 迷你按钮（直角款）：给 Editorial / Brutalism 这类"不要圆角"的主题用。
     由主题的 bg_pill attr 指向，layout 里写 ?attr/bg_pill 就自动跟着换。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="2dp" />
    <solid android:color="?attr/c_btn" />
    <stroke android:width="1.2dp" android:color="?attr/c_btn_border" />
</shape>
