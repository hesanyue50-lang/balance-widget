<?xml version="1.0" encoding="utf-8"?>
<!-- 新拟物凸起：左上白高光 + 右下灰阴影 + 中间表面 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="3dp" android:top="3dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_dark" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:left="0dp" android:top="0dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_light" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_surface" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</layer-list>
