        android:pathData="M3.2,18.4 L9.6,12.2 L14.4,16 L20.8,7.6"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M18.6,7.6 A2.2,2.2 0 1,0 22.9,7.6 A2.2,2.2 0 1,0 18.6,7.6 Z" />
</vector>
