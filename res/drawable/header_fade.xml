<?xml version="1.0" encoding="utf-8"?>
<!-- 悬浮导航的"底座"：从顶部实色渐变到底部全透明。
     内容从下面滚过去时自然淡出，比一条实心色块+分隔线的"贴纸感"轻很多。
     （LinkMesh 里叫"下方淡出层"，半圆胶囊不能用 elevation，分离感全靠这个 + 1dp 描边） -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="?attr/c_bg"
        android:centerColor="?attr/c_bg"
        android:endColor="#00FFFFFF"
        android:type="linear" />
</shape>
