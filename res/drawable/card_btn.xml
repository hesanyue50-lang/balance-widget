<?xml version="1.0" encoding="utf-8"?>
<!-- 小按钮背景：与 API 卡片同色系同圆角风格，但无 9-patch 固有内边距，尺寸可控 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="16dp" />
    <!-- 纯白底 + 无描边 = 放在白色卡片上完全看不见。
         补 1.2dp 描边，让它成为一个"能看出边界"的按钮。 -->
    <solid android:color="@color/btn_c" />
    <stroke android:width="1.2dp" android:color="@color/btn_border" />
</shape>
