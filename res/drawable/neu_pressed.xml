<?xml version="1.0" encoding="utf-8"?>
<!-- 新拟物按压（凹陷）：内阴影感，表面用 neu_sunken -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_sunken" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#22000000" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:left="3dp" android:top="3dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_sunken" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</layer-list>
