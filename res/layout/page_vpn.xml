<?xml version="1.0" encoding="utf-8"?>
<!-- 网络加速（Clash）独立页
     它是本应用里唯一「重度」的功能区：订阅、启停、策略组、节点列表、逐个测速，
     塞在设置里会把设置页撑得很长，所以单独成页。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vpn_page"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- ========== 订阅管理 ========== -->
    <LinearLayout
        style="@style/SectionCard"
        android:layout_marginTop="13dp">

        <TextView
            style="@style/FieldHint"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="10dp"
            android:text="@string/vpn_import_tip" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                style="@style/FieldLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="VPN 订阅管理" />

            <TextView
                android:id="@+id/btn_add_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/mini_btn_border"
                android:gravity="center"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="＋ 新增"
                android:textColor="@color/accent"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            style="@style/FieldHint"
            android:layout_marginTop="4dp"
            android:text="可同时保存多个机场订阅。点一行即启用它；长按可重命名或删除。" />

        <LinearLayout
            android:id="@+id/sub_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- ========== 运行状态 ========== -->
    <!-- 原来这里是「订阅地址输入框 + 更新配置 + 启动加速」：
         地址框只是展示（编辑在上面的订阅管理里做），"更新配置"又和每行的
         「更新」重复 —— 两块占地方却没多少用。现在改成真正的状态面板。 -->
    <LinearLayout style="@style/SectionCard">

        <TextView
            style="@style/FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="0"
            android:text="运行状态" />

        <TextView
            android:id="@+id/proxy_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="3dp"
            android:text="状态：未启动"
            android:textColor="@color/tx3"
            android:textSize="12sp" />

        <!-- 运行中才有内容：当前节点 / 本次运行 / 代理流量（代码动态填充） -->
        <LinearLayout
            android:id="@+id/run_kv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/btn_proxy_run"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/mini_btn_border"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="启动加速"
            android:textColor="@color/accent"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- ========== 代理模式 ==========
         放在「节点」正上方：先定代理范围，再挑具体节点，顺序符合使用逻辑。 -->
    <LinearLayout style="@style/SectionCard" android:layout_marginTop="13dp">

        <TextView
            style="@style/FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="0"
            android:text="代理模式" />

        <TextView
            style="@style/FieldHint"
            android:layout_marginTop="4dp"
            android:text="决定哪些流量走代理。前两种只影响本应用、无需授权；「系统全局」会建立系统 VPN 接管整机。" />

        <LinearLayout
            android:id="@+id/mode_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- ========== 节点 ========== -->
    <LinearLayout
        android:id="@+id/node_card"
        style="@style/SectionCard"
        android:layout_marginTop="13dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="节点"
                android:textColor="@color/tx"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_test_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/mini_btn_border"
                android:gravity="center"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="全部测速"
                android:textColor="@color/accent"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 策略组选择（订阅里通常有「节点选择」这类组） -->
        <TextView
            android:id="@+id/group_pick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/mini_btn_border"
            android:gravity="center"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:text="策略组：—"
            android:textColor="@color/tx"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/node_hint"
            style="@style/FieldHint"
            android:layout_marginTop="10dp"
            android:text="点节点即切换；点右侧延迟数字可单独重测该节点。" />

        <LinearLayout
            android:id="@+id/node_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- ========== 分流开关 ========== -->
    <LinearLayout
        android:id="@+id/route_card"
        style="@style/SectionCard"
        android:layout_marginTop="13dp">

        <TextView
            style="@style/FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="0"
            android:text="以下平台走代理" />

        <TextView
            style="@style/FieldHint"
            android:layout_marginTop="4dp"
            android:text="未勾选的平台一律直连 —— 国内平台直连更快，也不浪费机场流量。" />

        <LinearLayout
            android:id="@+id/proxy_plats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />
    </LinearLayout>
</LinearLayout>
