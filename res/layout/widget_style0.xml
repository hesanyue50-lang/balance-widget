                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/w2_div3"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/w2_row4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">


                <LinearLayout
                    android:id="@+id/w2_slot7"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="6dp"
                    android:background="@drawable/wslot_pill">

                    <TextView
                        android:id="@+id/w2_dot7"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginEnd="7dp"
                        android:background="@color/ws0_accent" />

                    <TextView
                        android:id="@+id/w2_name7"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:textColor="@color/ws0_tx2"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/w2_val7"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                    android:textStyle="bold"
                        android:textColor="@color/ws0_tx"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/w2_slot8"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="6dp"
                    android:background="@drawable/wslot_pill">

                    <TextView
                        android:id="@+id/w2_dot8"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginEnd="7dp"
                        android:background="@color/ws0_accent" />

                    <TextView
                        android:id="@+id/w2_name8"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:textColor="@color/ws0_tx2"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/w2_val8"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                    android:textStyle="bold"
                        android:textColor="@color/ws0_tx"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
