<?xml version="1.0" encoding="utf-8"?>
<!-- Aurora 亮：玻璃柔光 · 双列胶囊 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w2_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wg_t0"
    android:padding="16dp">

    <!-- 玻璃高光：背景之上、内容之下，只在顶部露出淡淡一层白 -->
    <ImageView
        android:id="@+id/w2_frost"
        android:scaleType="fitXY"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="top"
        android:background="@drawable/wg_frost" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="left">

            <TextView
                android:id="@+id/w2_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:textColor="#FF5A6472"
                android:textSize="11.5sp"
                android:text="API 余额" />

            <TextView
                android:id="@+id/w2_page"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:minWidth="0dp"
                android:includeFontPadding="false"
                android:textColor="#FF5A6472"
                android:textSize="10.5sp" />

            <ImageView
                android:id="@+id/w2_prev"
                android:clickable="true"
                android:focusable="true"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="2dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chevron_left"
                android:contentDescription="上一页" />

            <ImageView
                android:id="@+id/w2_next"
                android:clickable="true"
                android:focusable="true"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chevron_right"
                android:contentDescription="下一页" />

            <ImageView
                android:id="@+id/w2_refresh"
                android:clickable="true"
                android:focusable="true"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_refresh"
                android:contentDescription="刷新" />
        </LinearLayout>

        <TextView
            android:id="@+id/w2_total"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:includeFontPadding="false"
            android:gravity="center"
        android:textStyle="bold"
            android:textColor="@color/ws0_tx"
            android:textSize="34sp"
            android:text="—" />

        <TextView
            android:id="@+id/w2_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:ellipsize="end"
            android:gravity="center"
            android:textColor="@color/ws0_tx3"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/w2_row1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">


                <LinearLayout
                    android:id="@+id/w2_slot1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="6dp"
                    android:background="@drawable/wslot_pill">

                    <TextView
                        android:id="@+id/w2_dot1"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginEnd="7dp"
                        android:background="@color/ws0_accent" />

                    <TextView
                        android:id="@+id/w2_name1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:textColor="@color/ws0_tx2"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/w2_val1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                    android:textStyle="bold"
                        android:textColor="@color/ws0_tx"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/w2_slot2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="6dp"
                    android:background="@drawable/wslot_pill">

                    <TextView
                        android:id="@+id/w2_dot2"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginEnd="7dp"
                        android:background="@color/ws0_accent" />

                    <TextView
                        android:id="@+id/w2_name2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:textColor="@color/ws0_tx2"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/w2_val2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                    android:textStyle="bold"
                        android:textColor="@color/ws0_tx"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/w2_div1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/w2_row2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">


                <LinearLayout
                    android:id="@+id/w2_slot3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="6dp"
                    android:background="@drawable/wslot_pill">

                    <TextView
                        android:id="@+id/w2_dot3"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginEnd="7dp"
                        android:background="@color/ws0_accent" />

                    <TextView
                        android:id="@+id/w2_name3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:textColor="@color/ws0_tx2"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/w2_val3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                    android:textStyle="bold"
                        android:textColor="@color/ws0_tx"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/w2_slot4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="6dp"
                    android:background="@drawable/wslot_pill">

                    <TextView
                        android:id="@+id/w2_dot4"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginEnd="7dp"
                        android:background="@color/ws0_accent" />

                    <TextView
                        android:id="@+id/w2_name4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:textColor="@color/ws0_tx2"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/w2_val4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                    android:textStyle="bold"
                        android:textColor="@color/ws0_tx"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/w2_div2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/w2_row3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">


                <LinearLayout
                    android:id="@+id/w2_slot5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="6dp"
                    android:background="@drawable/wslot_pill">

                    <TextView
                        android:id="@+id/w2_dot5"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginEnd="7dp"
                        android:background="@color/ws0_accent" />

                    <TextView
                        android:id="@+id/w2_name5"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:textColor="@color/ws0_tx2"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/w2_val5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                    android:textStyle="bold"
                        android:textColor="@color/ws0_tx"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/w2_slot6"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="6dp"
                    android:background="@drawable/wslot_pill">

                    <TextView
                        android:id="@+id/w2_dot6"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginEnd="7dp"
                        android:background="@color/ws0_accent" />

                    <TextView
                        android:id="@+id/w2_name6"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:textColor="@color/ws0_tx2"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/w2_val6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                    android:textStyle="bold"
