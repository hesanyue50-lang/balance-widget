        </LinearLayout>
    </LinearLayout>

    <!-- 分档线 2 -->
    <TextView
        android:id="@+id/w2_div2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="9dp"
        android:background="@color/w2_div"
        android:visibility="gone" />

    <!-- 第 3 行 -->
