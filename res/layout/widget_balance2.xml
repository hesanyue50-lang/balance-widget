                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:textColor="@color/w2_tx"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 分档线 1 -->
    <TextView
