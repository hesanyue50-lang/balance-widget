<?xml version="1.0" encoding="utf-8"?>
<!-- 结构：FrameLayout + 浮动顶部栏 + 横向分页
     —— PanelPager（HorizontalScrollView）铺满全屏，里面并排三页，各自独立滚动；
        左右滑动切换页面，松手自动吸附到整页。
     —— 顶部栏浮在最上层，不随页面平移；滚动过程中它的导航滑块会跟着滑动进度走。
     —— 顶部栏的 paddingTop 由代码按状态栏/刘海高度设置（见 UiInsets）。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <com.minis.balancewidget.PanelPager
        android:id="@+id/panel_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/pages"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- ① API 余额页 -->
            <com.minis.balancewidget.PullScrollView
                android:id="@+id/scroll_api"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingBottom="20dp"
                android:scrollbars="none"
                android:overScrollMode="never">

                <include layout="@layout/page_api" />
            </com.minis.balancewidget.PullScrollView>

            <!-- ② 用量统计页 -->
            <com.minis.balancewidget.PullScrollView
                android:id="@+id/scroll_stats"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingBottom="20dp"
                android:scrollbars="none"
                android:overScrollMode="never">

                <include layout="@layout/page_stats" />
            </com.minis.balancewidget.PullScrollView>

            <!-- ③ 设置页 -->
            <com.minis.balancewidget.PullScrollView
                android:id="@+id/scroll_settings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingBottom="20dp"
                android:scrollbars="none"
                android:overScrollMode="never">

                <include layout="@layout/page_settings" />
            </com.minis.balancewidget.PullScrollView>
        </LinearLayout>
    </com.minis.balancewidget.PanelPager>

    <!-- 下拉刷新指示器：顶部栏正下方的小胶囊（三页共用，同一时刻只有一个页面在下拉）。
         topMargin 由 PullScrollView 按顶部栏高度同步（见 applyIndicatorTop），
         所以它不会压到顶部栏，也不会浮在状态栏上。 -->
    <LinearLayout
        android:id="@+id/pull_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/pull_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="14dp"
        android:paddingTop="7dp"
        android:paddingRight="16dp"
        android:paddingBottom="7dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/pull_spin"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:indeterminateTint="@color/accent" />

        <TextView
            android:id="@+id/pull_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="下拉刷新"
            android:textColor="@color/tx2"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 顶部栏 -->
    <LinearLayout
        android:id="@+id/app_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/header_bg"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="12dp"
        android:paddingBottom="14dp">

        <!-- 分段导航：三个等宽按钮 + 一个会滑动的选中滑块。
             滑块在文字**下层**（FrameLayout 先画的在下），文字颜色随滑动进度渐变。 -->
        <FrameLayout
            android:id="@+id/seg_wrap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/seg_bg"
            android:padding="5dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="6dp">

            <View
                android:id="@+id/seg_slider"
                android:layout_width="40dp"
                android:layout_height="1dp"
                android:background="@drawable/seg_sel" />

            <LinearLayout
                android:id="@+id/seg_tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tab_api"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="API 余额"
                    android:textColor="@color/accent"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tab_stats"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="用量统计"
                    android:textColor="@color/tx2"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btn_settings"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="⚙ 设置"
                    android:textColor="@color/tx2"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- 加载遮罩：切面板 / 重建统计 / 保存密钥这些活儿虽然现在快多了，
         但第一次渲染、Keystore 加密仍可能占住主线程几百毫秒 ——
         盖一层并显示进度条，用户至少知道「在干活」而不是以为点坏了。
         clickable=true 顺带拦住误触。 -->
    <LinearLayout
        android:id="@+id/busy_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:gravity="center"
            android:minWidth="180dp"
            android:orientation="vertical"
            android:paddingLeft="26dp"
            android:paddingTop="22dp"
            android:paddingRight="26dp"
            android:paddingBottom="22dp">

            <ProgressBar
                android:id="@+id/busy_spin"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:indeterminateTint="@color/accent" />

            <TextView
                android:id="@+id/busy_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="正在加载…"
                android:textColor="@color/tx2"
                android:textSize="13sp" />

            <!-- 横向进度条：活儿没进度可报时按不确定态来回滚，比干等一个圈更有反馈 -->
            <ProgressBar
                android:id="@+id/busy_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="150dp"
                android:layout_height="4dp"
                android:layout_marginTop="12dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/accent" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
