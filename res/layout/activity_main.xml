<?xml version="1.0" encoding="utf-8"?>
<!-- 结构：FrameLayout + 浮动顶部栏
     —— ScrollView 铺满全屏，顶部栏浮在其上且半透明，
        内容滚过时从顶部栏下方透出，形成毛玻璃层次。
     —— 顶部栏的 paddingTop 由代码按状态栏/刘海高度设置（见 MainActivity）。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ScrollView
        android:id="@+id/main_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingBottom="20dp"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 总资产 -->
            <LinearLayout
                android:id="@+id/total_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/total_bg"
                android:padding="31dp"
                android:layout_marginBottom="13dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/main_total_label"
                    android:textColor="@color/tx2"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/t_total"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="—"
                    android:textColor="@color/tx"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/t_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/tap_refresh"
                    android:textColor="@color/tx3"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 平台卡片容器（动态填充） -->
            <LinearLayout
                android:id="@+id/cards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- 用量统计页（Tab 切换显示，默认隐藏） -->
            <LinearLayout
                android:id="@+id/stats_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- ① 图表 + 日期颗粒度（叠在 X 轴行右端，与日期轴同一行） -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.minis.balancewidget.UsageChartView
                        android:id="@+id/usage_chart"
                        android:layout_width="match_parent"
                        android:layout_height="250dp"
                        android:background="@drawable/card_bg"
                        android:padding="10dp" />

                    <TextView android:id="@+id/range_pick" android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|right"
                        android:layout_marginRight="6dp"
                        android:layout_marginBottom="10dp"
                        android:gravity="center"
                        android:background="@drawable/card_btn" android:paddingLeft="12dp" android:paddingRight="12dp"
                        android:paddingTop="4dp" android:paddingBottom="4dp"
                        android:text="近 7 天 ▽" android:textColor="@color/tx" android:textSize="11sp" />
                </FrameLayout>

                <!-- ③ 平台数据源开关（圆点+名称+Switch） -->
                <LinearLayout
                    android:id="@+id/stats_platforms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="6dp" />

                <!-- API 列表 与 余额总结 之间的分割线 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp"
                    android:background="@color/neu_dark" />

                <!-- ④ 近 N 日 -->
                <TextView
                    android:id="@+id/stats_range_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="近 7 日"
                    android:textColor="@color/tx"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- ⑤ 每平台充值/消耗明细 -->
                <LinearLayout
                    android:id="@+id/stats_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/btn_fix_recharge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="right"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/card_bg"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp"
                    android:text="修正充值"
                    android:textColor="@color/tx"
                    android:textSize="12sp" />

                <!-- ⑥ 总充值 / 总消耗 -->
                <TextView
                    android:id="@+id/stats_totals"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/tx"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- ⑦ 清理数据（红） -->
                <TextView android:id="@+id/stats_clean" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_gravity="right"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="28dp" android:gravity="center"
                    android:background="@drawable/card_bg" android:paddingLeft="18dp" android:paddingRight="18dp"
                    android:paddingTop="10dp" android:paddingBottom="10dp"
                    android:text="清理数据" android:textColor="@color/danger" android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 顶部栏 -->
    <LinearLayout
        android:id="@+id/app_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/header_bg"
        android:paddingLeft="18dp"
        android:paddingRight="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/main_title"
            android:textColor="@color/tx"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Tab 与标题同区 -->
        <TextView
            android:id="@+id/tab_api"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:gravity="center"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="API 余额"
            android:textColor="@color/tx"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tab_stats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:background="@drawable/card_bg"
            android:gravity="center"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="用量统计"
            android:textColor="@color/tx2"
            android:textSize="12sp" />

        <!-- 设置=齿轮小按钮，最右 -->
        <TextView
            android:id="@+id/btn_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:background="@drawable/card_bg"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="⚙"
            android:textColor="@color/tx2"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
